    "@octokit/rest": "^19.0.13",
    "@octokit/types": "^15.0.1",
    "@prisma/client": "^6.18.0",
    "@upstash/redis": "^1.35.6",
    "axios": "^1.12.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^6.0.0",
    "zod": "^4.1.12"
  },
